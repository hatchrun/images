# Pinned inputs of the image. Third-party versions must be at least two
# weeks old before they land here.

UBUNTU_RELEASE=26.04

# https://nodejs.org/dist/. hatchrun-agent runs JavaScript actions with
# these (node12, node16 and node20 actions use 20, the rest 24).
NODE20_VERSION=20.20.2
NODE20_SHA256_X64=df770b2a6f130ed8627c9782c988fda9669fa23898329a61a871e32f965e007d
NODE20_SHA256_ARM64=73093db209e4e9e09dd7d15a47aeaab1b74833830df03efa5f942a1122c5fa71
NODE24_VERSION=24.22.1
NODE24_SHA256_X64=6c172a9ab6718f7b801fb5a7bd486af2ee5e32758086a04b84fcce2aa77095e6
NODE24_SHA256_ARM64=dbabf7a1cbf947e6059ffad2c27b80041db97dea1e553b62afdee7f13fca336e

# https://github.com/hatchrun/hatchrun/releases. First-party: it ships as
# soon as it is released, and the two-week rule does not apply.
AGENT_VERSION=0.67.1

# Docker's release signing key, https://docs.docker.com/engine/install/ubuntu/
DOCKER_GPG_FINGERPRINT=9DC858229FC7DD38854AE2D88D81803C0EBFCD88

# https://releases.hashicorp.com/packer/. The amazon plugin is pinned in
# packer/ubuntu.pkr.hcl and checked by packer init.
PACKER_VERSION=1.16.1
PACKER_SHA256_LINUX_AMD64=af38a9e93e4ed1b9ca68206ae969c64c300c82a3dde46a780dfa629f0867f651

# https://github.com/aquasecurity/trivy/releases. Scans the image inside
# the builder and is removed before the image is made; CI uses the x64
# build to turn the result into SARIF and an SBOM.
TRIVY_VERSION=0.74.0
TRIVY_SHA256_LINUX_X64=2ae6fe3ee734b7fdf11335663e18c75ea12dccc76062f09f164a3b0f8be4371a
TRIVY_SHA256_LINUX_ARM64=b94ce1976bbf3c15b514b605ee88be7c6d94a29be2302847ff01cb794d47aad5
